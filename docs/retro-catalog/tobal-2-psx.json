{
  "id": "tobal-2-psx",
  "name": "Tobal 2",
  "kind": "recomp",
  "platform": "psx",
  "description": "Tobal 2 (Japan) recompiled for the Sony PlayStation using psxrecomp. English (default) or original Japanese text, chosen on the launcher's home screen.",
  "homepage": "https://github.com/MatheusLeffa/Tobal2Recomp",
  "rom_identity": {
    "crc32": ["479f1388"],
    "md5": ["9d583bcc0ee949f42e07fa8613939d8d"],
    "sha1": ["50edccaaccf002673a817047905372603e63e208"],
    "sha256": ["04e79535b4616963e045957b4f9b87126753e94b01d35d32c60214df04bf5a5a"],
    "disc_serials": ["SLPM-86033"],
    "sizes": [669555600],
    "filenames": ["Tobal 2 (Japan) (v1.1).cue", "Tobal 2 (Japan) (v1.1).bin"],
    "track_counts": [1],
    "require_cue": true
  },
  "rom_extensions": [".cue", ".bin"],
  "release": {
    "github": "MatheusLeffa/Tobal2Recomp",
    "asset_glob": {
      "linux": "*linux*",
      "windows": "*windows*",
      "macos": "*macos*"
    }
  },
  "install_dir_name": "Tobal2Recomp",
  "launch": {
    "linux": "Tobal_2_Recompiled",
    "windows": "Tobal_2_Recompiled.exe",
    "macos": "Tobal_2_Recompiled"
  },
  "romm": {
    "platforms": ["ps", "psx", "ps1"]
  },
  "notes": "Digests from game.toml [prepare_disc] (Redump Tobal 2 (Japan) (v1.1)). Release zips are setup kits (no game code): Retro generates and builds from the user's disc. Our psxrecomp/recomp-ui patches are applied inside the release kit.",
  "build": {
    "enabled": true,
    "source": {
      "github": "MatheusLeffa/Tobal2Recomp",
      "ref": "main"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.14",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build-release",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
