From bbf9fe1797d9765bbeb85cb47fa12358f9c4ef63 Mon Sep 17 00:00:00 2001
From: Matt <83082324+MatheusLeffa@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:11:20 -0300
Subject: [PATCH 3/3] dashboard: "cards" layout (cover + disc, controllers and
 settings cards)

GameInfo.dashboard_cards (appended) selects a compact home: the cover on the
left and four cards on the right -- game disc (file, verdict, Change disc),
controllers (per-player source combo + Configure) and the title's settings
cards (Language, Characters). Zero keeps the existing dashboard.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/backends/imgui/launcher_imgui.cpp | 113 +++++++++++++++++++
 src/common/launcher_model.c                  |   1 +
 src/common/launcher_model.h                  |   1 +
 src/recomp_launcher.h                        |   7 ++
 4 files changed, 122 insertions(+)

diff --git a/src/common/backends/imgui/launcher_imgui.cpp b/src/common/backends/imgui/launcher_imgui.cpp
index 5281521..5203565 100644
--- a/src/common/backends/imgui/launcher_imgui.cpp
+++ b/src/common/backends/imgui/launcher_imgui.cpp
@@ -3836,8 +3836,14 @@ void panel_controller_draw(LauncherModel* m, const LauncherTheme* th) {
 // (SAVES only when the game has SRAM, folded into the GAME card — see
 // draw_save_row). A different system's profile simply contributes a
 // different panel list.
+static void draw_cards_dashboard(LauncherModel* m, const LauncherTheme& th, int logical_w);
+
 void draw_dashboard(LauncherModel* m, const LauncherTheme& th, int logical_w) {
     g_game_visible_h = ImGui::GetWindowHeight();
