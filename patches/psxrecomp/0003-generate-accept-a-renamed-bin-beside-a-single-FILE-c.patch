+
 def list_cue_bins(cue_path: Path) -> list[Path]:
     """Return every BINARY FILE referenced by a cue, in order."""
     text = cue_path.read_text(encoding="utf-8", errors="replace")
@@ -270,7 +294,12 @@ def list_cue_bins(cue_path: Path) -> list[Path]:
         if not cand.is_absolute():
             cand = cue_path.parent / cand
         if not cand.is_file():
-            raise SystemExit(f"cue references missing bin: {cand}")
+            sibling = cue_sibling_image(cue_path) if len(names) == 1 else None
+            if sibling is None:
+                raise SystemExit(f"cue references missing bin: {cand}")
+            print(f"note: cue names {cand.name}, which does not exist; "
+                  f"using {sibling.name} beside the cue")
+            cand = sibling
         out.append(cand.resolve())
     return out
 
